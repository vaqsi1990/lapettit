generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum CakeCategory {
  BIRTHDAY
  WEDDING
  ANNIVERSARY
  CUSTOM
  Desserts
}

enum ProductType {
  FULL_CAKE       // სრული ტორტი
  SET             // ნაკრები
  INDIVIDUAL_SLICE // ინდივიდუალური ნაჭერი
}

model Cake {
  id            Int        @id @default(autoincrement())
  name          String

  // სტანდარტული ატრიბუტები
  imageUrl      String?     // მთავარი სურათი

  category      CakeCategory
  productType   ProductType @default(FULL_CAKE)  // პროდუქტის ტიპი
  available     Boolean     @default(true)  // არის თუ არა გაყიდვაში

  // კონფიგურაცია
  isCustomizable Boolean    @default(false)  // შეიძლება თუ არა რედაქტირება

  // ფასი
  price         Float?      // სტანდარტული ფასი (მხოლოდ isCustomizable: false-ისთვის)

  // შიგთავსი და შემადგენლობა
  fillings      String[]    // შიგთავსი (მაგ: ["კრემი", "ჯემი"])
  hasMarzipan   Boolean     @default(false)
  marzipanPrice Float?
  hasCream      Boolean     @default(false)
  creamPrice    Float?

  // ზომები
  pieces        Int?        // ნაჭრები (მაგ: 8, 12, 16) - FULL_CAKE-ისთვის

  // ნაკრებისთვის (SET)
  setItems      String[]    // ნაკრებში შემავალი პროდუქტები (მაგ: ["4 ტორტის ნაჭერი", "2 ნაღვლის რქა"])
  setDescription String?    // ნაკრების აღწერა

  // ინდივიდუალური ნაჭრისთვის (INDIVIDUAL_SLICE)
  sliceWeight   String?     // ნაჭრის წონა (მაგ: "200გრ")
  sliceDescription String?  // ნაჭრის აღწერა

  // Custom დეტალები (მხოლოდ მაშინ თუ isCustomizable == true)
  age           String?     // მაგ: "2 წლის", "18 წლის"
  quantity      Int?        // რამდენი ცალი
  deliveryDate  DateTime?
  deliveryTime  String?

  // შეკვეთები
  orders        OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}


model Order {
  id            Int          @id @default(autoincrement())
  customerName  String
  customerPhone String
  customerEmail String?
  address       String

  items         OrderItem[]
  total         Float


  bogOrderId    String?   @unique
  paidAt        DateTime? @db.Timestamp(6)
  isPaid        Boolean   @default(false)

  isDelivered   Boolean   @default(false)
  deliveredAt   DateTime? @db.Timestamp(6)

  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
}

model OrderItem {
  id       Int   @id @default(autoincrement())
  order    Order @relation(fields: [orderId], references: [id])
  orderId  Int
  cake     Cake  @relation(fields: [cakeId], references: [id])
  cakeId   Int
  quantity Int   @default(1)
  
  // Custom cake personalization
  cakeName String?  // Name to be written on the cake
  age      String?  // Age to be written on the cake (e.g., "2 წლის", "18 წლის")
  position String?  // Position on cake: "bottom", "center", "top"
}

model ChatSession {
  id              Int            @id @default(autoincrement())
  sessionId       String         @unique
  currentStep     Int            @default(0)
  isComplete      Boolean        @default(false)  // Survey completion status
  isChatEnded     Boolean        @default(false)  // Chat conversation ended status
  waitingForPrice Boolean        @default(false)  // Waiting for admin to calculate and send price
  calculatedPrice Float?         // Price calculated by admin
  productId       Int?           // Product ID if survey started from product page
  responses       ChatResponse[]
  messages        ChatMessage[]  // All chat messages (bot, user, admin)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ChatResponse {
  id           Int         @id @default(autoincrement())
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId    Int
  questionId   Int         // Question number
  questionText String
  answerType   String      // "multiple_choice", "file", "text"
  selectedOption Int?      // For multiple choice questions (0-3)
  answerText   String?     // For text answers
  fileUrl      String?     // For file uploads
  fileName     String?     // Original file name
  createdAt    DateTime    @default(now())
}

model ChatMessage {
  id          Int         @id @default(autoincrement())
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   Int
  senderType  String      // "bot", "user", "admin"
  content     String      // Message text
  fileUrl     String?     // For file attachments
  fileName    String?     // Original file name
  imageUrl    String?     // For image messages
  isRead      Boolean     @default(false) // For admin messages
  createdAt   DateTime    @default(now())
}