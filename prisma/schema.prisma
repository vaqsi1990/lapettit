generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum CakeCategory {
  BIRTHDAY
  WEDDING
  ANNIVERSARY
  CUSTOM
  Desserts
}
model Cake {
  id            Int          @id @default(autoincrement())
  name          String
  description   String?
  price         Float
  imageUrl      String?        // მთავარი სურათი
  gallery       String[]       // დამატებითი სურათები (სხვადასხვა კუთხე/დიზაინი)
  category      CakeCategory
  servings      Int?           // რამდენი ადამიანს ჰყოფნის (მაგ: 8, 12, 16)
  weightKg      Float?         // წონა კილოგრამებში
  flavors       String[]       // გემოები: ["შოკოლადი", "ვანილი", "წითელი ხავერდი"]
  allergens     String[]       // ალერგენები: ["კაკალი", "რძე", "გლუტენი"]
  isCustomizable Boolean       @default(false) // პერსონალიზაცია შეიძლება?
  available     Boolean        @default(true)  // არის თუ არა გაყიდვაში
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        OrderItem[]
}

model CustomCake {
  id            Int       @id @default(autoincrement())
  design        String
  flavor        String
  filling       String?
  glaze         String?
  shape         String?
  decorations   String[]  // Array of decoration names
  text          String?
  quantity      Int
  deliveryDate  DateTime
  deliveryTime  String?
  imageUrl      String?
  createdAt     DateTime  @default(now())

  order    Order @relation(fields: [orderId], references: [id])
  orderId  Int   @unique
}

model Order {
  id            Int          @id @default(autoincrement())
  customerName  String
  customerPhone String
  customerEmail String?
  address       String

  items         OrderItem[]
  total         Float

  customCake    CustomCake?

  bogOrderId    String?   @unique
  paidAt        DateTime? @db.Timestamp(6)
  isPaid        Boolean   @default(false)

  isDelivered   Boolean   @default(false)
  deliveredAt   DateTime? @db.Timestamp(6)

  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
}

model OrderItem {
  id       Int   @id @default(autoincrement())
  order    Order @relation(fields: [orderId], references: [id])
  orderId  Int
  cake     Cake  @relation(fields: [cakeId], references: [id])
  cakeId   Int
  quantity Int   @default(1)
}